    "codex-agent": "workspace:*",
    "matrix-client": "workspace:*",
    "mattermost-client": "workspace:*",
    "messaging-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "bun-types": "^1.3.14"
  }
}

{
  "name": "codex-channel-mattermost",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "codex-mattermost-channel": "./codex-server.ts",
    "codex-mattermost-access": "./codex-access-cli.ts"
  },
  "scripts": {
    "start": "bun install --no-summary && bun codex-server.ts",
    "check": "bun build ./codex-server.ts --target=bun --outfile=/tmp/codex-check.js && rm -f /tmp/codex-check.js"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.142.4",
    "mattermost-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
